# =====================================================================
# Suvidhi — Environment Variables (Next.js)
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Next.js only exposes variables prefixed with NEXT_PUBLIC_ to the browser
# bundle. Variables WITHOUT that prefix (e.g. RAZORPAY_KEY_SECRET) stay
# server-only and are never shipped to the client.
#
# IMPORTANT: NEXT_PUBLIC_* values are INLINED AT BUILD TIME. Changing any of
# them requires a rebuild (`npm run build`) — restarting the server is not
# enough, and editing them on a running production server does nothing.
# =====================================================================

# ---------- Brand ----------
NEXT_PUBLIC_BRAND_NAME=Suvidhi
NEXT_PUBLIC_BRAND_EMAIL=innohealthbysush@gmail.com
NEXT_PUBLIC_BRAND_PHONE=+919810880970
NEXT_PUBLIC_BRAND_PHONE_DISPLAY=+91 98108 80970

# ---------- Pricing: the two things that can be bought ----------
# The funnel sells ONE call. /oto offers it two ways and the chosen plan is
# carried to /checkout as ?plan=call|bundle.
#
#   call   → the ₹97 Postpartum Recovery Roadmap Call on its own.
#            Confirmation page: /confirmed (1 step — book the slot).
#   bundle → the same call + The Postpartum Restore Video Library + the
#            WhatsApp community. Confirmation page: /confirmed-plus
#            (3 steps — book, join WhatsApp, claim course access).
#
# BUNDLE IS AN ALL-IN PRICE, NOT AN ADD-ON. Selecting the bundle REPLACES the
# ₹97 line rather than adding to it, so the buyer is charged ₹497 total.
# To make it additive instead, set this to 594 (97 + 497).
NEXT_PUBLIC_CALL_PRICE_INR=97
NEXT_PUBLIC_BUNDLE_PRICE_INR=497
NEXT_PUBLIC_OFFER_CURRENCY=INR
# Shown in the Razorpay modal + sent as Meta `content_name`.
NEXT_PUBLIC_OFFER_NAME=Postpartum Recovery Roadmap Call

# The paid 90-day programme. NOT sold on the landing page — quoted in exactly
# one place, FAQ Q.07, and nowhere else.
NEXT_PUBLIC_PROGRAMME_START_INR=14500

# ---------- Social proof (must be identical everywhere) ----------
# ONE number the clinician can defend live on a call. It renders in the hero
# badge row, the hero proof line, the stat bar, the CTA blocks, the marquee,
# the sticky bar and the checkout summary — all from this single value.
# Years in practice is a SEPARATE, non-competing stat; never blend them.
NEXT_PUBLIC_PROOF_MOTHERS=200+
NEXT_PUBLIC_PROOF_RATING=4.9
NEXT_PUBLIC_PROOF_YEARS=7
NEXT_PUBLIC_PROOF_RECOVERY_WEEKS=12wk

# ---------- Offer countdown ----------
# The window shown in all six CTA blocks and on checkout. A near-5-hour window
# reads as a daily offer; a 15-minute one reads as a trick.
NEXT_PUBLIC_OFFER_WINDOW_HOURS=4
NEXT_PUBLIC_OFFER_WINDOW_MINUTES=59
NEXT_PUBLIC_OFFER_WINDOW_SECONDS=58

# ---------- Coupon ----------
# 100%-discount test coupon. Skips Razorpay entirely and routes straight to the
# confirmation page, so you can validate the redirect without paying.
# NOTE: the coupon INPUT is currently removed from the checkout UI — this only
# affects the internal free-order code path.
NEXT_PUBLIC_TEST_COUPON_CODE=tgotest2025
NEXT_PUBLIC_TEST_COUPON_DISCOUNT_PCT=100

# ---------- Razorpay ----------
# Public key id (safe to ship to the browser).
# Get from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
NEXT_PUBLIC_RAZORPAY_COMPANY_NAME=InnoHealth · Suvidhi
NEXT_PUBLIC_RAZORPAY_THEME_COLOR=#CB4A5D
# SERVER-ONLY secret — used by app/api/razorpay/* to create orders and verify
# signatures. Never prefix this with NEXT_PUBLIC_.
RAZORPAY_KEY_SECRET=REPLACE_ME
# SERVER-ONLY. Razorpay Dashboard → Settings → Webhooks. Without this the
# webhook at /api/razorpay/webhook rejects every event, and NOTHING is written
# to Pabbly or sent to Meta CAPI for UPI payers who never return to the tab.
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ---------- Calendly (drives the booking embed) ----------
# Full event URL — e.g. https://calendly.com/innohealthbysush/roadmap-call
# Embedded as the Step 1 calendar on BOTH /confirmed and /confirmed-plus.
# Leave it unset and those pages render a "Calendar coming up" placeholder
# instead of a live booking widget — nobody can book.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/REPLACE_ME/roadmap-call
NEXT_PUBLIC_CALENDLY_HIDE_GDPR=1
NEXT_PUBLIC_CALENDLY_HIDE_EVENT_TYPE_DETAILS=0

# ---------- WhatsApp community (bundle buyers only) ----------
# Powers the Step 2 "Join the community" button on /confirmed-plus.
# Unset → the button is replaced by an "invite is on its way by email" note.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/REPLACE_ME

# ---------- Course platform / Skool (bundle buyers only) ----------
# Powers the Step 3 "Open the course platform" button on /confirmed-plus, so a
# buyer whose invite email landed in spam still has a way in.
# Unset → the button is hidden and only the email instructions show.
NEXT_PUBLIC_SKOOL_COMMUNITY_URL=https://www.skool.com/REPLACE_ME/about

# ---------- Meta / Facebook Pixel + CAPI ----------
NEXT_PUBLIC_META_PIXEL_ID=REPLACE_ME
NEXT_PUBLIC_META_TEST_EVENT_CODE=
# SERVER-ONLY CAPI access token. Without it, AddToCart / InitiateCheckout /
# sales events are skipped silently.
META_CAPI_ACCESS_TOKEN=REPLACE_ME
# Optional Graph API version override (defaults to v25.0).
META_GRAPH_API_VERSION=

# ---------- Pabbly Connect (webhook) ----------
# Webhook URL — every completed order POSTs to this address from the Razorpay
# webhook handler.
NEXT_PUBLIC_PABBLY_WEBHOOK_URL=

# ---------- Optional analytics ----------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
